DOMAIN=joedodge.dev
NODE_NAME=my-laptop
REGISTRY_S3_BUCKET=not-so-localhost-backups
REGISTRY_S3_PREFIX=nsl/registry/v1
AWS_REGION=us-east-1
ENROLLMENT_BROKER_URL=https://nsl-enrollment-broker.example.workers.dev
NSL_ENROLLMENT_TOKEN=
REGISTRY_VERSION=dev
NSL_AUTH_OWNER=false
REGISTRY_API_TOKEN=<generate-a-node-local-cli-token>
REGISTRY_PROXY_TOKEN=<generate-a-local-proxy-token>
OAUTH2_CLIENT_SECRET_REGISTRY=<same-on-every-node>
OAUTH2_COOKIE_SECRET=<same-on-every-node>
KEYCLOAK_USER_PASSWORD=<initial-user-password>
KEYCLOAK_ADMIN_PASSWORD=<bootstrap-admin-password>
CORPORATE_CA_FILE=./cloudflared/ca-bundle.empty.pem
BACKUP_TARGETS_FILE_HOST=./backup/targets.empty.json

# Set only on the one machine that owns Keycloak and its local PostgreSQL.
# COMPOSE_PROFILES=auth
# NSL_AUTH_OWNER=true
# NSL_AUTH_CLAIM_TOKEN=<same-as-broker-auth-claim-secret>
