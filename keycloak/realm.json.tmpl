{
  "realm": "local",
  "enabled": true,
  "clients": [
    {
      "clientId": "registry",
      "name": "NSL Registry",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "${OAUTH2_CLIENT_SECRET_REGISTRY}",
      "redirectUris": ["https://apps.${DOMAIN}/oauth2/callback"],
      "webOrigins": ["https://apps.${DOMAIN}"],
      "publicClient": false,
      "standardFlowEnabled": true,
      "serviceAccountsEnabled": true,
      "protocolMappers": [{"name":"groups","protocol":"openid-connect","protocolMapper":"oidc-group-membership-mapper",
        "config":{"claim.name":"groups","full.path":"false","id.token.claim":"true","access.token.claim":"true","userinfo.token.claim":"true"}}]
    }
  ],
  "groups": [
    {"name": "admin"}
  ],
  "users": [
    {"username":"service-account-registry","enabled":true,"serviceAccountClientId":"registry","clientRoles":{"realm-management":["view-users","query-users"]}},
    {
      "username": "joe",
      "enabled": true,
      "emailVerified": true,
      "email": "joe@${DOMAIN}",
      "groups": ["admin"],
      "credentials": [
        {"type": "password", "value": "${KEYCLOAK_USER_PASSWORD}", "temporary": false}
      ]
    }
  ]
}
