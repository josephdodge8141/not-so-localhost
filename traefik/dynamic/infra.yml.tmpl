http:
  middlewares:
    auth:
      chain:
        middlewares:
          - identity-clean
          - auth-error
          - auth-check

    identity-clean:
      headers:
        customRequestHeaders:
          X-Forwarded-User: ""
          X-Forwarded-Email: ""
          X-Forwarded-Preferred-Username: ""
          X-Forwarded-Groups: ""
          X-Auth-Request-Email: ""
          X-Auth-Request-User: ""
          X-Auth-Request-Preferred-Username: ""
          X-Auth-Request-Groups: ""
          X-NSL-Proxy-Token: ""

    auth-check:
      forwardAuth:
        address: "http://oauth2-proxy:4180/oauth2/auth"
        authResponseHeaders:
          - "X-Auth-Request-User"
          - "X-Auth-Request-Email"
          - "X-Auth-Request-Preferred-Username"
          - "X-Auth-Request-Groups"

    authz-check:
      forwardAuth:
        address: "http://authz:4181"

    auth-error:
      errors:
        status:
          - "401"
        service: oauth2-proxy-signin
        query: "/oauth2/sign_in?rd={url}"

    registry-trust:
      headers:
        customRequestHeaders:
          X-NSL-Proxy-Token: "${REGISTRY_PROXY_TOKEN}"

  routers:
    oauth2-callback:
      rule: "PathPrefix(`/oauth2`)"
      priority: 1000
      entryPoints:
        - web
      service: oauth2-proxy

    keycloak:
      rule: "Host(`auth.${DOMAIN}`)"
      priority: 100
      entryPoints:
        - web
      service: keycloak

    registry:
      rule: "Host(`apps.${DOMAIN}`)"
      priority: 100
      entryPoints:
        - web
      middlewares:
        - auth
        - registry-trust
      service: registry

    ttyd:
      rule: "Host(`t--${NODE_SLUG}.${DOMAIN}`)"
      priority: 100
      entryPoints:
        - web
      middlewares:
        - auth
        - authz-check
      service: ttyd

  services:
    keycloak:
      loadBalancer:
        servers:
          - url: "http://keycloak:8080"

    registry:
      loadBalancer:
        servers:
          - url: "http://registry:7272"

    ttyd:
      loadBalancer:
        servers:
          - url: "http://host.docker.internal:7681"

    oauth2-proxy:
      loadBalancer:
        servers:
          - url: "http://oauth2-proxy:4180"

    oauth2-proxy-signin:
      loadBalancer:
        servers:
          - url: "http://authz:4181"
